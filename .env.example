# Generate strong independent passwords before docker compose up.
POSTGRES_PASSWORD=replace-with-random-database-owner-password
APP_DB_PASSWORD=replace-with-random-application-password
# API and worker use a non-superuser role; migrations use owner credentials.
DATABASE_URL=sqlite:///./uag.db
EXECUTION_MODE=local
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100/api/v1
ENVIRONMENT=development
SESSION_HOURS=8
# Keys and service addresses are administrator-controlled; never tenant form input.
SIGNING_KEY_PATH=
TRUSTED_SIGNING_KEYS_DIR=
# cdxgen secure mode needs an existing absolute staging directory without spaces.
# Optional native override; Docker uses its isolated /tmp automatically.
UAG_SCAN_TMP_ROOT=
OPA_URL=
PRESIDIO_ANALYZER_URL=
PRESIDIO_ANONYMIZER_URL=
